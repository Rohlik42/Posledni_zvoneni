{
  "name": "malgym-2066",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MALGYM 2066 – low-poly punk FPS v Malostranském gymnáziu",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:data": "tsx --test tests/data/*.test.ts",
    "test": "npm run test:data && playwright test --project=smoke",
    "test:e2e": "playwright test --project=e2e",
    "test:full": "npm run build && npm run test:data && playwright test",
    "tool": "tsx"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.29.0",
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/gui": "^9.29.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.29.0",
    "@babylonjs/post-processes": "^9.29.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.29.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/yuka": "^0.7.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
