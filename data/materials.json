    "floor-parquet-gym": { "texture": "floor-parquet-gym", "tint": "world.parquet", "tintStrength": 0.2, "fallback": { "pattern": "grid", "colors": ["world.parquet", "world.woodDark"], "sizeM": 0.7 } },
    "stair-tread": { "texture": "stair-tread", "tint": "world.concrete", "tintStrength": 0.2, "fallback": { "pattern": "noise", "colors": ["world.concrete", "base.ash"], "sizeM": 0.5 } },
