    "wall-wainscot-wood": { "texture": "wall-wainscot-wood", "tint": "world.wood", "tintStrength": 0.2, "fallback": { "pattern": "grid", "colors": ["world.wood", "world.woodDark"], "sizeM": 1.0 } },
